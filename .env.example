# Copy to .env and adjust for your local environment

DEMO_COMPANY_IDS=DEMO_A,DEMO_B
POSTGRES_PASSWORD=local_dev_only

# Organizer chat-completions gateway; leave empty until credentials are issued.
LLM_BASE_URL=
LLM_API_KEY=
LLM_EXTRACTION_MODEL=
LLM_ANALYSIS_MODEL=
# JSON array of actual organizer IDs and confirmed RUB prices; see docs/llm.md.
LLM_MODEL_CATALOG_JSON=[]
LLM_PRICES_CONFIRMED=0
# token_prices requires confirmed tariffs. gateway_receipt exclusively reserves
# the remaining daily budget and requires a cost receipt on every response.
LLM_BUDGET_MODE=token_prices
# Explicit conversion from this organizer gateway's receipt unit to RUB.
# Never assume that a generic LiteLLM USD receipt is denominated in RUB.
LLM_RECEIPT_RUB_PER_UNIT=
LLM_DAILY_LIMIT_RUB=500
LLM_MAX_CALLS=8
LLM_MAX_TOOLS=8
LLM_TIMEOUT_SECONDS=45
# Server policy: * means the loaded bank corpus; comma-separated IDs restrict it.
BANK_ALLOWED_DOCUMENT_IDS=*
